{
  "enabled": false,
  "name": "Evaluate high-risk changes for feature flags",
  "description": "On file save in a high-risk directory, asks Kiro to evaluate whether the change needs a feature flag and offer to create one. Disabled by default — enable after editing filePattern to match your team's high-risk paths.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "filePattern": "src/payments/**/*.ts"
  },
  "then": {
    "type": "askAgent",
    "prompt": "The file $FILE_PATH was just saved with changes in a high-risk domain. Decide whether these changes need a feature flag by following steering/evaluate-change.md and steering/high-risk-domains.md. If they do: (1) Look for an existing flag before suggesting a new one, following steering/find-existing-flag.md. (2) If a new flag is needed, propose a name and type following steering/feature-flag-conventions.md and steering/high-risk-domains.md. (3) Offer to create it with manage_flag (action: define) and to write the guard code following steering/wrap-change.md. Do not create anything in Unleash without the user's confirmation."
  }
}

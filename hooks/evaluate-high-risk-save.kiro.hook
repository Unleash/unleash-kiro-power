{
  "enabled": false,
  "name": "Evaluate high-risk changes for feature flags",
  "description": "On file save in a high-risk directory, asks Kiro to evaluate whether the change needs a feature flag and offer to create one. Disabled by default — enable after editing filePattern to match your team's high-risk paths.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "filePattern": "src/payments/**/*.ts"
  },
  "then": {
    "type": "askAgent",
    "prompt": "The file $FILE_PATH was just saved with changes in a high-risk domain. Judge whether these changes should be behind a feature flag, using the rules in steering/feature-flag-conventions.md and steering/high-risk-domains.md. If the answer is yes: (1) Call the Unleash MCP server's search tool (kind: flags) to check for an existing matching flag before suggesting a new one. (2) If a new flag is needed, propose a name following the team's naming convention from steering/feature-flag-conventions.md and steering/high-risk-domains.md. (3) Offer to create it with manage_flag (action: define) and to write the guard code, using the flag-checking pattern this codebase already uses. Do not auto-create — wait for user confirmation."
  }
}
